---
layout: null
---
[
  {% for pub in site.data.publications %}
  {
    "title": {{ pub.title | jsonify }},
    "description": {{ pub.venue | append: ", " | append: pub.year | jsonify }},
    "category": "Publication",
    "url": {{ site.baseurl | append: "/publications/#" | append: pub.anchor | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
  {% if site.data.publications.size > 0 and site.projects.size > 0 %},{% endif %}
  {% for proj in site.projects %}
  {
    "title": {{ proj.title | jsonify }},
    "description": {{ proj.subtitle | jsonify }},
    "category": "Project",
    "url": {{ proj.url | relative_url | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
  {% if site.projects.size > 0 and site.data.teaching.size > 0 %},{% endif %}
  {% for item in site.data.teaching %}
  {
    "title": {{ item.title | strip_html | jsonify }},
    "description": {{ item.role | append: " — " | append: item.description | jsonify }},
    "category": "Teaching",
    "url": {{ site.baseurl | append: "/teaching/" | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
  {% if site.data.teaching.size > 0 and site.data.news.size > 0 %},{% endif %}
  {% for item in site.data.news %}
  {
    "title": {{ item.html | strip_html | truncate: 80 | jsonify }},
    "description": {{ item.type | append: " · " | append: item.date | jsonify }},
    "category": "News",
    "url": {{ site.baseurl | append: "/news/" | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
  {% if site.data.news.size > 0 and site.posts.size > 0 %},{% endif %}
  {% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "description": {{ post.excerpt | strip_html | truncate: 100 | jsonify }},
    "category": "Blog",
    "url": {{ post.url | relative_url | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
