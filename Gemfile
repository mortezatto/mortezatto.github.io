source "https://rubygems.org"

# Deploying via GitHub Actions (not the classic github-pages build), so we
# aren't tied to GitHub's Jekyll 3.x allowlist — this pins Jekyll directly.
gem "jekyll", "~> 4.3"
gem "jekyll-sitemap"

# Needed on Ruby 3+ (webrick was removed from the standard library).
gem "webrick"
